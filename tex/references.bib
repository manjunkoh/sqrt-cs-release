@inproceedings{oguriSuccessiveConvexificationFeasibility2023a,
  title = {Successive {{Convexification}} with {{Feasibility Guarantee}} via {{Augmented Lagrangian}} for {{Non-Convex Optimal Control Problems}}},
  booktitle = {2023 62nd {{IEEE Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
