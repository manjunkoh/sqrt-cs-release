  annotation = {In press},
  file = {/Users/nkumagai/Zotero/storage/69JEKMQW/Kumagai and Oguri - 2025 - Robust Cislunar Low-Thrust Trajectory Optimization Under Uncertainties via Sequential Covariance Ste.pdf}
}

