@inproceedings{oguriChanceConstrainedControlSafe2024a,
  title = {Chance-{{Constrained Control}} for {{Safe Spacecraft Autonomy}}: {{Convex Programming Approach}}},
  shorttitle = {Chance-{{Constrained Control}} for {{Safe Spacecraft Autonomy}}},
